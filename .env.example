# Credentials for GitHub OAuth (Get these from GitHub Developer Settings)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# A random string used to secure session cookies (e.g., use `openssl rand -base64 32`)
SESSION_SECRET=

# URL to the GitFest API (e.g., https://gitfest.com)
NEXT_PUBLIC_GITFEST_URL=

# Credentials for GitHub App (used for committing the README and layout)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend Email Configuration
RESEND_API_KEY=
EMAIL_FROM=GitAscii <team@gitascii.com>
EMAIL_REPLY_TO=GitAscii Support <support@gitascii.com>
NEXT_PUBLIC_APP_URL=https://gitascii.com
CRON_SECRET=
